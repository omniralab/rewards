# Tryb Live /app (prawdziwe transakcje na Solana devnet). Bez tych zmiennych
# strona działa jak dotąd, a przełącznik Live się nie pokazuje.
#
# Katalog z kluczami company.json, agent.json, attestor.json (format Solana
# CLI) i mint.txt (adres testowego tUSDC z scripts/live-setup.mjs).
LIVE_KEYS_DIR=
# Albo zamiast katalogu: klucze jako tablice JSON i adres tokenu.
LIVE_COMPANY_KEY=
LIVE_AGENT_KEY=
LIVE_ATTESTOR_KEY=
LIVE_MINT=
# Opcjonalnie: inny węzeł RPC niż publiczny devnet i inny adres programu.
SOLANA_RPC_URL=
LIVE_PROGRAM_ID=
